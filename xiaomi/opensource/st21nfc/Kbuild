# $(src) is relative to the object tree when M= is a relative path
# (LineageOS inline kernel build): use the absolute source directory
XM_SRC := $(if $(filter /%,$(src)),$(src),$(srctree)/$(src))
# ST21NFC (STMicroelectronics) NFC driver, built as stm_nfc_i2c.ko like stock sapphire
# (stock source path: vendor/stnfc/opensource/driver/nfc/st21nfc.c)

STOCK_ROOT := /home/work/mnt/miui_codes1/build_home_rom-odm-merged/kernel_platform/msm-kernel
ccflags-y += -fmacro-prefix-map=$(XM_SRC)/=$(STOCK_ROOT)/../../vendor/stnfc/opensource/driver/nfc/


obj-m += stm_nfc_i2c.o
stm_nfc_i2c-objs := st21nfc.o
