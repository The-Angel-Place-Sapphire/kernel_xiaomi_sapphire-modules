# SPDX-License-Identifier: GPL-2.0
# $(src) is relative to the object tree when M= is a relative path
# (LineageOS inline kernel build): use the absolute source directory
XM_SRC := $(if $(filter /%,$(src)),$(src),$(srctree)/$(src))
#
# Xiaomi battery authentication chain for sapphire (stock path:
# drivers/power/supply/battery_secret/).  Sources: Huaqin battery_secrete
# (picasso09 moon / linastorvaldz gold / Niyush sm4450) + MiCode topaz
# battery_secret onewire_gpio glue, front-ends adapted to the stock
# sapphire (khaje) binaries.
#
#   battery_auth_class.ko  auth class + onewire_gpio platform driver (exports)
#   auth_battery.ko        "lc,auth-battery" batt_verify psy + auth_battery IIO
#   ds28e30_verify.ko      Maxim DS28E30
#   slg_verify.ko          SLG
#   stick_verify.ko        ST STICK
#

obj-m += battery_auth_class.o
obj-m += auth_battery.o

# ---- ds28e30_verify.ko ----
obj-m += ds28e30_verify.o

ds28e30_verify-y += \
	ds28e30.o	\
	ds28e30lib/bignum.o	\
	ds28e30lib/deep_cover_coproc.o	\
	ds28e30lib/ecc_generate_key.o	\
	ds28e30lib/ecdsa_generic_api.o	\
	ds28e30lib/ecdsa_high.o		\
	ds28e30lib/sha256_hmac.o	\
	ds28e30lib/sha256_software.o	\
	ds28e30lib/sha256_stone.o	\
	ds28e30lib/ucl_rng.o	\
	ds28e30lib/ucl_sha256.o	\
	ds28e30lib/ucl_sha3.o	\
	ds28e30lib/ucl_sia256.o	\
	ds28e30lib/ucl_sys.o

$(foreach o,$(ds28e30_verify-y),$(eval CFLAGS_$(o) += -I$(XM_SRC)/ds28e30lib))
$(foreach o,$(ds28e30_verify-y),$(eval CFLAGS_$(o) += -fmacro-prefix-map=$(XM_SRC)/=drivers/power/supply/battery_secret/))

# ---- stick_verify.ko ----
include $(XM_SRC)/stick.mk

# ---- slg_verify.ko ----
obj-m += slg_verify.o
slg_verify-objs := \
    slg.o   \
    slglib/uECC.o

# same Huaqin battery_secrete Makefile flags as stick (slg does not depend on them)
$(foreach o,$(slg_verify-objs),$(eval CFLAGS_$(o) += $(STICK_CFLAGS)))
