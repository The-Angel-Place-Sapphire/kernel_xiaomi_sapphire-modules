#                         <this dir>/qpnp-smb5-stock.symvers"
# panel_event_notifier resolves from the msm-kernel out/Module.symvers.

STOCK_ROOT := /home/work/mnt/miui_codes1/build_home_rom-odm-merged/kernel_platform/msm-kernel
ccflags-y += -fmacro-prefix-map=$(src)/=$(STOCK_ROOT)/../../vendor/qcom/opensource/touch-drivers/./fts_touch_i2c/
