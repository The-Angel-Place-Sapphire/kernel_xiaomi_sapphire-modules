# $(src) is relative to the object tree when M= is a relative path
# (LineageOS inline kernel build): use the absolute source directory
XM_SRC := $(if $(filter /%,$(src)),$(src),$(srctree)/$(src))
# MIUI ADD: MiSight_LogEnhance
# Xiaomi miev (MiCode piano-w-oss drivers/staging/miev), sapphire build.
# the source uses C99 for-loop declarations (official tree is built as gnu11)
ccflags-y += -std=gnu11 -I$(XM_SRC)/include -DCONFIG_MIEV_MODULE=1
obj-m += miev.o
miev-y += midevice.o
miev-y += mievent.o
# END MiSight_LogEnhance
